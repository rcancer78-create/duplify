<Window x:Class="Duplify.BulkResolveDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Массовый разбор дубликатов"
        Width="580"
        MinHeight="220"
        MaxHeight="720"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource WindowBgBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="{StaticResource AppFont}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Массовый разбор дубликатов"
                       FontSize="16"
                       FontWeight="SemiBold" />
            <TextBlock Text="Задайте правило один раз — приложение отметит лишние копии во всех подходящих группах. Файлы не удаляются и не перемещаются: только меняются флажки."
                       TextWrapping="Wrap"
                       FontSize="12"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       Margin="0,4,0,0" />
        </StackPanel>

        <!-- Rule settings card -->
        <Border Grid.Row="1"
                Background="#1F1F23"
                BorderBrush="{StaticResource SubtleBorderBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="14"
                Margin="0,14,0,0">
            <StackPanel>
                <TextBlock Text="Предпочтительная папка (необязательно)"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Margin="0,0,0,6" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0"
                             AutomationProperties.AutomationId="BulkPreferredFolderTextBox"
                             Text="{Binding PreferredFolder, UpdateSourceTrigger=PropertyChanged}"
                             Height="30"
                             Padding="10,0"
                             VerticalContentAlignment="Center"
                             Margin="0,0,8,0"
                             ToolTip="Копии внутри этой папки и её подпапок считаются лучше копий вне неё" />
                    <Button Grid.Column="1"
                            Content="Обзор..."
                            Command="{Binding BrowseFolderCommand}"
                            Height="30"
                            Padding="12,0"
                            Margin="0,0,8,0" />
                    <Button Grid.Column="2"
                            Content="Очистить"
                            Command="{Binding ClearFolderCommand}"
                            Height="30"
                            Padding="12,0" />
                </Grid>
                <TextBlock Text="{Binding ValidationMessage}"
                           FontSize="12"
                           Foreground="#F87171"
                           TextWrapping="Wrap"
                           Margin="0,6,0,0"
                           Visibility="{Binding HasValidationError, Converter={StaticResource BooleanToVisibilityConverter}}" />

                <TextBlock Text="Если предпочтительная папка не задана, этот критерий не учитывается."
                           FontSize="11"
                           Foreground="{StaticResource TextDisabledBrush}"
                           TextWrapping="Wrap"
                           Margin="0,6,0,0" />

                <Border Height="1" Background="{StaticResource SubtleBorderBrush}" Margin="0,12,0,12" />

                <TextBlock Text="Резервное правило даты"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Margin="0,0,0,6" />
                <StackPanel Orientation="Horizontal">
                    <RadioButton Content="самый новый"
                                 AutomationProperties.AutomationId="BulkKeepNewestRadio"
                                 GroupName="BulkBackupRule"
                                 IsChecked="{Binding KeepNewest}"
                                 Margin="0,0,24,0" />
                    <RadioButton Content="самый старый"
                                 AutomationProperties.AutomationId="BulkKeepOldestRadio"
                                 GroupName="BulkBackupRule"
                                 IsChecked="{Binding KeepOldest}" />
                </StackPanel>

                <Border Height="1" Background="{StaticResource SubtleBorderBrush}" Margin="0,12,0,12" />

                <CheckBox IsChecked="{Binding PreferCleanName}" Margin="0,0,0,8">
                    <TextBlock Text="Предпочитать понятное имя без «копия», «copy», «duplicate», «дубликат» и числовых суффиксов"
                               TextWrapping="Wrap" />
                </CheckBox>
                <CheckBox Content="Предпочитать более короткий путь"
                          IsChecked="{Binding PreferShorterPath}"
                          Margin="0,0,0,8" />

                <TextBlock Text="Неоднозначные группы (где лучший ранг делят несколько файлов) всегда пропускаются — принудительный выбор недоступен."
                           FontSize="11"
                           Foreground="{StaticResource WarningBrush}"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!-- Preview card -->
        <Border Grid.Row="2"
                Background="#18181C"
                BorderBrush="{StaticResource SubtleBorderBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="14"
                Margin="0,14,0,0">
            <StackPanel>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="Предварительный итог"
                               FontSize="13"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                    <Button Grid.Column="1"
                            AutomationProperties.AutomationId="BulkCalculateButton"
                            Content="Рассчитать"
                            Command="{Binding CalculateCommand}"
                            Height="28"
                            Padding="12,0" />
                </Grid>

                <TextBlock Text="{Binding PreviewText}"
                           FontSize="13"
                           LineHeight="20"
                           TextWrapping="Wrap" />

                <TextBlock Text="{Binding PriorityDescription}"
                           FontSize="11"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           TextWrapping="Wrap"
                           Margin="0,8,0,0"
                           Visibility="{Binding HasCalculated, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </StackPanel>
        </Border>

        <!-- Buttons -->
        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button Content="Применить отметки"
                    AutomationProperties.AutomationId="BulkApplyButton"
                    Command="{Binding ApplyCommand}"
                    IsEnabled="{Binding CanApply}"
                    Style="{StaticResource AccentButtonStyle}"
                    Height="32"
                    Padding="16,0"
                    Margin="0,0,8,0"
                    IsDefault="True" />
            <Button Content="Отмена"
                    AutomationProperties.AutomationId="BulkCancelButton"
                    Command="{Binding CancelCommand}"
                    Height="32"
                    Padding="16,0"
                    IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
