<Window x:Class="Duplify.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="clr-namespace:Duplify.Models"
        xmlns:viewmodels="clr-namespace:Duplify.ViewModels"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}"
        Width="1180" Height="760"
        MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBgBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="{StaticResource AppFont}">

    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{Binding StartScanCommand}" />
        <KeyBinding Key="Escape" Command="{Binding CancelScanCommand}" />
    </Window.InputBindings>

    <DockPanel>
        <!-- APPLICATION MENU -->
        <Menu DockPanel.Dock="Top"
              AutomationProperties.AutomationId="MainMenu"
              Background="{StaticResource HeaderBgBrush}"
              Foreground="{StaticResource TextPrimaryBrush}"
              BorderBrush="{StaticResource BorderBrush}"
              BorderThickness="0,0,0,1"
              Padding="8,3">
            <MenuItem Header="Открыть журнал действий"
                      Command="{Binding OpenJournalCommand}"
                      ToolTip="Открыть %AppData%\Duplify\journal.jsonl" />
            <MenuItem Header="Открыть папку журналов ошибок"
                      Command="{Binding OpenLogsFolderCommand}"
                      ToolTip="Открыть %AppData%\Duplify\logs" />
            <MenuItem Header="О программе"
                      Command="{Binding ShowAboutCommand}" />
        </Menu>

        <Grid>
            <Grid.RowDefinitions>
                <!-- Top Controls Card -->
                <RowDefinition Height="Auto" />
                <!-- Progress Bar / Status -->
                <RowDefinition Height="Auto" />
                <!-- Main Content Area -->
                <RowDefinition Height="*" />
                <!-- Errors Panel (collapsible) -->
                <RowDefinition Height="Auto" />
                <!-- Status Bar -->
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- TOP CARD: SCAN CONTROLS -->
            <Border Grid.Row="0"
                    Background="{StaticResource HeaderBgBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="16,12">
                <StackPanel Orientation="Vertical">
                    <!-- Section 1: Logo & Folder Paths Grid -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <!-- App Brand / Logo -->
                            <ColumnDefinition Width="Auto" />
                            <!-- Unified 4-Column Folder Grid -->
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Brand Logo & Title -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,24,0">
                            <Border Width="38" Height="38" CornerRadius="8" Background="{StaticResource AccentBrush}" Margin="0,0,10,0">
                                <TextBlock Text="D" Foreground="White" FontWeight="Bold" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Duplify" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" LineHeight="18" />
                                <TextBlock Text="Поиск дубликатов" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Unified 4-Column Folder Grid -->
                        <Grid Grid.Column="1">
                            <Grid.ColumnDefinitions>
                                <!-- Label Column: shared width -->
                                <ColumnDefinition Width="Auto" />
                                <!-- Path Input Column -->
                                <ColumnDefinition Width="*" />
                                <!-- Browse Button Column -->
                                <ColumnDefinition Width="Auto" />
                                <!-- Scan / Clear Action Column -->
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <!-- Primary Folder -->
                                <RowDefinition Height="32" />
                                <!-- Spacer -->
                                <RowDefinition Height="8" />
                                <!-- Second Folder -->
                                <RowDefinition Height="32" />
                            </Grid.RowDefinitions>

                            <!-- Row 0: Primary Target Folder -->
                            <TextBlock Grid.Row="0" Grid.Column="0"
                                       Text="Основная папка:"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Margin="0,0,10,0" />

                            <Grid Grid.Row="0" Grid.Column="1" Margin="0,0,8,0">
                                <TextBox x:Name="FolderTextBox"
                                         AutomationProperties.AutomationId="FolderTextBox"
                                         Text="{Binding SelectedFolder, UpdateSourceTrigger=PropertyChanged}"
                                         IsEnabled="{Binding CanScan}"
                                         Height="32"
                                         Padding="10,0"
                                         VerticalContentAlignment="Center"
                                         ToolTip="Путь к целевой папке для поиска дубликатов" />
                                <TextBlock Text="Выберите папку для сканирования..."
                                           Foreground="{StaticResource TextDisabledBrush}"
                                           IsHitTestVisible="False"
                                           VerticalAlignment="Center"
                                           Margin="12,0,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedFolder}" Value="">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding SelectedFolder}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>

                            <Button Grid.Row="0" Grid.Column="2"
                                    AutomationProperties.AutomationId="BrowseButton"
                                    Content="📁 Обзор..."
                                    Command="{Binding BrowseFolderCommand}"
                                    IsEnabled="{Binding CanScan}"
                                    Height="32"
                                    MinWidth="96"
                                    Padding="12,0"
                                    Margin="0,0,8,0" />

                            <Grid Grid.Row="0" Grid.Column="3" MinWidth="190">
                                <!-- Start Scan (visible when not scanning) -->
                                <Button AutomationProperties.AutomationId="StartScanButton"
                                        Content="Начать сканирование (F5)"
                                        Command="{Binding StartScanCommand}"
                                        Style="{StaticResource AccentButtonStyle}"
                                        Height="32"
                                        Padding="16,0"
                                        HorizontalAlignment="Stretch"
                                        Visibility="{Binding IsScanning, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                                        IsEnabled="{Binding CanScan}" />

                                <!-- Cancel Scan (visible when scanning) -->
                                <Button AutomationProperties.AutomationId="CancelScanButton"
                                        Content="Остановить (Esc)"
                                        Command="{Binding CancelScanCommand}"
                                        Style="{StaticResource DangerButtonStyle}"
                                        Height="32"
                                        Padding="16,0"
                                        HorizontalAlignment="Stretch"
                                        Visibility="{Binding IsScanning, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </Grid>

                            <!-- Row 2: Optional Second Folder -->
                            <TextBlock Grid.Row="2" Grid.Column="0"
                                       Text="Вторая папка:"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Margin="0,0,10,0" />

                            <Grid Grid.Row="2" Grid.Column="1" Margin="0,0,8,0">
                                <TextBox x:Name="SecondFolderTextBox"
                                         AutomationProperties.AutomationId="SecondFolderTextBox"
                                         Text="{Binding SelectedSecondFolder, UpdateSourceTrigger=PropertyChanged}"
                                         IsEnabled="{Binding CanScan}"
                                         Height="32"
                                         Padding="10,0"
                                         VerticalContentAlignment="Center"
                                         ToolTip="Необязательно. Обе папки сканируются вместе — дубликаты ищутся внутри каждой и между ними." />
                                <TextBlock Text="необязательно — чтобы сравнить с другой папкой"
                                           Foreground="{StaticResource TextDisabledBrush}"
                                           IsHitTestVisible="False"
                                           VerticalAlignment="Center"
                                           Margin="12,0,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedSecondFolder}" Value="">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding SelectedSecondFolder}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>

                            <Button Grid.Row="2" Grid.Column="2"
                                    AutomationProperties.AutomationId="BrowseSecondFolderButton"
                                    Content="📁 Обзор..."
                                    Command="{Binding BrowseSecondFolderCommand}"
                                    IsEnabled="{Binding CanScan}"
                                    Height="32"
                                    MinWidth="96"
                                    Padding="12,0"
                                    Margin="0,0,8,0" />

                            <Button Grid.Row="2" Grid.Column="3"
                                    AutomationProperties.AutomationId="ClearSecondFolderButton"
                                    Content="Очистить"
                                    Command="{Binding ClearSecondFolderCommand}"
                                    IsEnabled="{Binding CanScan}"
                                    Height="32"
                                    Padding="16,0"
                                    HorizontalAlignment="Stretch" />
                        </Grid>
                    </Grid>

                    <!-- Subtle divider -->
                    <Border Height="1" Background="{StaticResource SubtleBorderBrush}" Margin="0,4,0,8" />

                    <!-- Section 2: Scan Options & Filters -->
                    <Grid>
                        <Grid.RowDefinitions>
                            <!-- Checkboxes row -->
                            <RowDefinition Height="Auto" />
                            <!-- Spacer -->
                            <RowDefinition Height="6" />
                            <!-- Filters row -->
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Checkboxes Row -->
                        <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <CheckBox AutomationProperties.AutomationId="IncludeSubfoldersCheckBox"
                                      Content="включая вложенные папки"
                                      IsChecked="{Binding IncludeSubdirectories}"
                                      IsEnabled="{Binding CanScan}"
                                      VerticalAlignment="Center"
                                      Margin="0,0,24,0" />

                            <CheckBox AutomationProperties.AutomationId="OnlyCrossRootCheckBox"
                                      Content="только между двумя папками"
                                      IsChecked="{Binding OnlyCrossRootDuplicates}"
                                      IsEnabled="{Binding CanScan}"
                                      VerticalAlignment="Center"
                                      ToolTip="Если задана вторая папка: показывать группы, где копии есть в обеих папках, без дубликатов только внутри одной"
                                      Margin="0,0,24,0" />

                            <CheckBox AutomationProperties.AutomationId="ExcludeSystemFoldersCheckBox"
                                      Content="исключить системные каталоги"
                                      IsChecked="{Binding ExcludeSystemFolders}"
                                      IsEnabled="{Binding CanScan}"
                                      VerticalAlignment="Center"
                                      ToolTip="Пропускать $Recycle.Bin, Windows, Program Files, System Volume Information..." />
                        </StackPanel>

                        <!-- Filter Fields Row -->
                        <Grid Grid.Row="2" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <!-- File Mask -->
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="105" />
                                <!-- Spacer -->
                                <ColumnDefinition Width="20" />
                                <!-- Min Size -->
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="80" />
                                <!-- Spacer -->
                                <ColumnDefinition Width="20" />
                                <!-- Exclude Folders -->
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" MinWidth="200" MaxWidth="380" />
                                <!-- Trailing flexible spacer -->
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Mask -->
                            <TextBlock Grid.Column="0" Text="Маска файлов:" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBox Grid.Column="1"
                                     AutomationProperties.AutomationId="FileMaskTextBox"
                                     Text="{Binding FileMask, UpdateSourceTrigger=PropertyChanged}"
                                     IsEnabled="{Binding CanScan}"
                                     Height="28"
                                     Padding="8,0"
                                     VerticalContentAlignment="Center"
                                     ToolTip="Фильтр файлов (например *.* или *.jpg;*.png)" />

                            <!-- Min size -->
                            <TextBlock Grid.Column="3" Text="Мин. размер (КБ):" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBox Grid.Column="4"
                                     AutomationProperties.AutomationId="MinSizeKbTextBox"
                                     Text="{Binding MinSizeKb, UpdateSourceTrigger=PropertyChanged}"
                                     IsEnabled="{Binding CanScan}"
                                     Height="28"
                                     Padding="8,0"
                                     VerticalContentAlignment="Center"
                                     ToolTip="Минимальный размер файла в килобайтах (0 — без ограничений)" />

                            <!-- Exclude Folders -->
                            <TextBlock Grid.Column="6" Text="Исключить папки:" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBox Grid.Column="7"
                                     AutomationProperties.AutomationId="ExcludeFolderNamesTextBox"
                                     Text="{Binding ExcludeFolderNames, UpdateSourceTrigger=PropertyChanged}"
                                     IsEnabled="{Binding CanScan}"
                                     Height="28"
                                     Padding="8,0"
                                     VerticalContentAlignment="Center"
                                     ToolTip="Имена папок через «;» — они не будут сканироваться (например .git;node_modules;AppData)" />
                        </Grid>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- PROGRESS NOTIFICATION BAR (Visible during scan) -->
            <Border Grid.Row="1"
                    Background="#202025"
                    BorderBrush="{StaticResource SubtleBorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="16,8"
                    Visibility="{Binding IsScanning, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding ScanPhase}" FontWeight="SemiBold" Foreground="{StaticResource AccentHoverBrush}" Margin="0,0,16,0" />
                            <TextBlock Text="Проверено: " Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBlock Text="{Binding FilesScanned}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,16,0" />

                            <!-- Hashing progress details -->
                            <StackPanel Orientation="Horizontal" Visibility="{Binding HashProgressTotal, Converter={StaticResource IntGreaterThanZeroToVisibilityConverter}}">
                                <TextBlock Text="Хеширование: " Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock Text="{Binding HashBytesProgressFormatted}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text=" (" Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock Text="{Binding HashProgressPercent, StringFormat='{}{0}%'}" FontWeight="SemiBold" Foreground="{StaticResource AccentHoverBrush}" />
                                <TextBlock Text=") " Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,16,0" />
                            </StackPanel>

                            <!-- Current scanned path -->
                            <TextBlock Text="📁 " Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBlock Text="{Binding CurrentScanPath}" TextTrimming="CharacterEllipsis" MaxWidth="500" Foreground="{StaticResource TextSecondaryBrush}" />
                        </StackPanel>

                        <!-- Elapsed time -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="⏱ " Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBlock Text="{Binding ElapsedTimeFormatted}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                        </StackPanel>
                    </Grid>

                    <ProgressBar Grid.Row="1"
                                 IsIndeterminate="{Binding IsIndeterminateProgress}"
                                 Value="{Binding HashProgressPercent}"
                                 Height="4" />
                </Grid>
            </Border>

            <!-- MAIN CONTENT AREA -->
            <Grid Grid.Row="2">

                <!-- Empty State 1: Before first scan -->
                <Border Visibility="{Binding HasScanned, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                        HorizontalAlignment="Center" VerticalAlignment="Center" Padding="32">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border Width="68" Height="68" CornerRadius="34" Background="#232328" BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="1" HorizontalAlignment="Center" Margin="0,0,0,16">
                            <TextBlock Text="🔍" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Готов к поиску дубликатов" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,8" />
                        <TextBlock Text="Выберите папку и нажмите «Начать сканирование» или нажмите клавишу F5."
                                   FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,16" />
                        <Button Content="Выбрать папку и начать"
                                Command="{Binding BrowseFolderCommand}"
                                Style="{StaticResource AccentButtonStyle}"
                                Height="36"
                                HorizontalAlignment="Center"
                                Padding="20,0" />
                    </StackPanel>
                </Border>

                <!-- Empty State 2: No duplicates found -->
                <Border Visibility="{Binding HasNoDuplicates, Converter={StaticResource BooleanToVisibilityConverter}}"
                        HorizontalAlignment="Center" VerticalAlignment="Center" Padding="32">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border Width="68" Height="68" CornerRadius="34" Background="#162E20" BorderBrush="#235A38" BorderThickness="1" HorizontalAlignment="Center" Margin="0,0,0,16">
                            <TextBlock Text="✓" FontSize="34" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Дубликатов нет" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,8" />
                        <TextBlock Text="Все проверенные файлы уникальны. Лишнего места не обнаружено."
                                   FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- Duplicate Results Split View -->
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Groups.Count, Converter={StaticResource IntGreaterThanZeroToVisibilityConverter}}" Value="Visible">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>

                    <Grid.ColumnDefinitions>
                        <!-- Left: Groups Pane -->
                        <ColumnDefinition Width="340" MinWidth="280" MaxWidth="500" />
                        <!-- Splitter -->
                        <ColumnDefinition Width="5" />
                        <!-- Right: Selected Group Files Pane -->
                        <ColumnDefinition Width="*" MinWidth="400" />
                    </Grid.ColumnDefinitions>

                    <!-- LEFT PANE: GROUPS LIST -->
                    <Grid Grid.Column="0" Background="#1B1B1E">
                        <Grid.RowDefinitions>
                            <!-- Header -->
                            <RowDefinition Height="Auto" />
                            <!-- Groups List -->
                            <RowDefinition Height="*" />
                            <!-- Global selection quick actions -->
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Groups Pane Header -->
                        <Border Grid.Row="0" Background="#202024" BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="0,0,0,1" Padding="14,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Группы дубликатов" FontWeight="SemiBold" FontSize="13" />
                                    <Border Background="#33333C" CornerRadius="10" Padding="8,2" Margin="8,0,0,0">
                                        <TextBlock Text="{Binding Groups.Count}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="Потрачено места ↓" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <!-- Groups ListBox -->
                        <ListBox Grid.Row="1"
                                 AutomationProperties.AutomationId="GroupsListBox"
                                 ItemsSource="{Binding Groups}"
                                 SelectedItem="{Binding SelectedGroup}"
                                 ItemContainerStyle="{StaticResource GroupListBoxItemStyle}"
                                 ScrollViewer.CanContentScroll="True"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling"
                                 VirtualizingPanel.ScrollUnit="Item"
                                 Padding="10,8">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:DuplicateGroup}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <!-- Sample File Name -->
                                        <TextBlock Grid.Row="0"
                                                   Text="{Binding SampleFileName}"
                                                   FontWeight="SemiBold"
                                                   FontSize="13"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,0,0,6" />

                                        <!-- Badges Row -->
                                        <WrapPanel Grid.Row="1" Orientation="Horizontal">
                                            <!-- File count badge -->
                                            <Border Background="#2C2C34" CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                                                <TextBlock Text="{Binding CountFormatted}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                            </Border>

                                            <!-- Size per file -->
                                            <Border Background="#2C2C34" CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                                                <TextBlock Text="{Binding SizeFormatted}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                            </Border>

                                            <!-- Wasted space badge -->
                                            <Border Background="#3B1C1C" CornerRadius="4" Padding="6,2">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="Лишнее: " FontSize="11" Foreground="#FCA5A5" />
                                                    <TextBlock Text="{Binding WastedSpaceFormatted}" FontSize="11" FontWeight="SemiBold" Foreground="#F87171" />
                                                </StackPanel>
                                            </Border>
                                        </WrapPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- Global result actions for all groups -->
                        <Border Grid.Row="2" Background="#202024" BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="0,1,0,0" Padding="12,8">
                            <StackPanel Orientation="Vertical">
                                <Button AutomationProperties.AutomationId="BulkResolveButton"
                                        Content="✨ Массовый разбор…"
                                        Command="{Binding OpenBulkResolveCommand}"
                                        IsEnabled="{Binding CanBulkResolve}"
                                        Style="{StaticResource AccentButtonStyle}"
                                        Height="30"
                                        Margin="0,0,0,10"
                                        ToolTip="Задать правило один раз и автоматически отметить лишние копии во всех подходящих группах (без удаления)" />

                                <TextBlock Text="Отметить во всех группах:" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6" />
                                <UniformGrid Columns="2">
                                    <Button AutomationProperties.AutomationId="KeepNewestAllGroupsButton"
                                            Content="Оставить новый"
                                            Command="{Binding KeepNewestAllGroupsCommand}"
                                            ToolTip="Во всех группах отметить все файлы для удаления/перемещения, кроме самого нового"
                                            Height="28"
                                            Margin="0,0,4,0"
                                            Padding="6,0"
                                            FontSize="11" />
                                    <Button AutomationProperties.AutomationId="KeepOldestAllGroupsButton"
                                            Content="Оставить старый"
                                            Command="{Binding KeepOldestAllGroupsCommand}"
                                            ToolTip="Во всех группах отметить все файлы для удаления/перемещения, кроме самого старого"
                                            Height="28"
                                            Margin="4,0,0,0"
                                            Padding="6,0"
                                            FontSize="11" />
                                </UniformGrid>

                                <Border Height="1" Background="{StaticResource SubtleBorderBrush}" Margin="0,10,0,10" />

                                <TextBlock Text="{Binding SelectedSummary}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,6" />
                                <Button AutomationProperties.AutomationId="ClearAllMarksButton"
                                        Content="Снять все отметки"
                                        Command="{Binding ClearAllMarksCommand}"
                                        IsEnabled="{Binding CanPerformActions}"
                                        ToolTip="Снять все отметки во всех группах"
                                        Height="28"
                                        HorizontalAlignment="Stretch"
                                        Padding="6,0"
                                        FontSize="11" />
                                <Button AutomationProperties.AutomationId="ShowNextAmbiguousButton"
                                        Content="Показать следующую неоднозначную"
                                        Command="{Binding ShowNextAmbiguousCommand}"
                                        IsEnabled="{Binding CanShowNextAmbiguous}"
                                        ToolTip="Перейти к следующей группе, которую массовый разбор пропустил как неоднозначную"
                                        Height="28"
                                        Margin="0,6,0,0"
                                        HorizontalAlignment="Stretch"
                                        Padding="6,0"
                                        FontSize="11" />
                                <TextBlock Text="{Binding AmbiguousSummaryFormatted}"
                                           FontSize="11"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- GRID SPLITTER -->
                    <GridSplitter Grid.Column="1"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch"
                                  Background="#26262B"
                                  ShowsPreview="False" />

                    <!-- RIGHT PANE: FILES IN SELECTED GROUP -->
                    <Grid Grid.Column="2" Background="{StaticResource WindowBgBrush}">
                        <Grid.RowDefinitions>
                            <!-- Group Header & Resolve Toolbar -->
                            <RowDefinition Height="Auto" />
                            <!-- Files List -->
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Right Pane Toolbar Card -->
                        <Border Grid.Row="0"
                                Background="#202024"
                                BorderBrush="{StaticResource SubtleBorderBrush}"
                                BorderThickness="0,0,0,1"
                                Padding="16,10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Row 0: Group Info & Hash -->
                                <Grid Grid.Row="0" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Summary info -->
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Файлы в группе:" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,8,0" />
                                        <TextBlock Text="{Binding SelectedGroup.CountFormatted}" FontSize="13" Foreground="{StaticResource AccentHoverBrush}" FontWeight="SemiBold" Margin="0,0,8,0" />
                                        <TextBlock Text="•  Размер каждого: " FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                                        <TextBlock Text="{Binding SelectedGroup.SizeFormatted}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,8,0" />
                                        <TextBlock Text="•  Потеряно: " FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                                        <TextBlock Text="{Binding SelectedGroup.WastedSpaceFormatted}" FontSize="12" FontWeight="Bold" Foreground="#F87171" />
                                    </StackPanel>

                                    <!-- SHA-256 Hash -->
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding SelectedGroup.Hash, StringFormat='SHA-256: {0}'}"
                                               FontSize="11"
                                               FontFamily="Consolas, monospace"
                                               Foreground="{StaticResource TextDisabledBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               MaxWidth="320"
                                               VerticalAlignment="Center"
                                               ToolTip="{Binding SelectedGroup.Hash}" />
                                </Grid>

                                <!-- Row 1: Selection & Actions Bar -->
                                <Border Grid.Row="1"
                                        Background="#18181C"
                                        BorderBrush="{StaticResource SubtleBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="10,8">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="8" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <!-- Row 0: Quick selection helpers -->
                                        <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="Отметить в группе:" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <Button AutomationProperties.AutomationId="KeepNewestInGroupButton"
                                                    Content="Оставить самый новый"
                                                    Command="{Binding KeepNewestInGroupCommand}"
                                                    ToolTip="Отметить все файлы в текущей группе, кроме самого свежего по дате изменения"
                                                    Height="28"
                                                    Padding="10,0"
                                                    FontSize="12"
                                                    Margin="0,0,6,0" />
                                            <Button AutomationProperties.AutomationId="KeepOldestInGroupButton"
                                                    Content="Оставить самый старый"
                                                    Command="{Binding KeepOldestInGroupCommand}"
                                                    ToolTip="Отметить все файлы в текущей группе, кроме самого раннего по дате создания/изменения"
                                                    Height="28"
                                                    Padding="10,0"
                                                    FontSize="12"
                                                    Margin="0,0,6,0" />
                                            <Button AutomationProperties.AutomationId="SelectAllButton"
                                                    Content="Все"
                                                    Command="{Binding SelectAllInGroupCommand}"
                                                    ToolTip="Отметить все файлы в этой группе"
                                                    Height="28"
                                                    Padding="10,0"
                                                    FontSize="12"
                                                    Margin="0,0,6,0" />
                                            <Button AutomationProperties.AutomationId="UnselectAllButton"
                                                    Content="Снять"
                                                    Command="{Binding UnselectAllInGroupCommand}"
                                                    ToolTip="Снять отметки со всех файлов в этой группе"
                                                    Height="28"
                                                    Padding="10,0"
                                                    FontSize="12" />
                                        </StackPanel>

                                        <!-- Row 2: Destructive / Move actions -->
                                        <Grid Grid.Row="2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0"
                                                       Text="Все отмеченные файлы:"
                                                       FontSize="12"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,8,0" />
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                                                <!-- Delete checked -->
                                                <Button AutomationProperties.AutomationId="DeleteSelectedButton"
                                                        Content="🗑 Удалить (во всех группах)"
                                                        Command="{Binding DeleteSelectedCommand}"
                                                        Style="{StaticResource DangerButtonStyle}"
                                                        IsEnabled="{Binding CanPerformActions}"
                                                        Height="28"
                                                        Padding="10,0"
                                                        FontSize="12"
                                                        Margin="0,0,8,0"
                                                        ToolTip="Удалить в Корзину все отмеченные файлы во всех группах, а не только в открытой" />

                                                <!-- Move checked -->
                                                <Button AutomationProperties.AutomationId="MoveSelectedButton"
                                                        Content="📂 Переместить… (во всех группах)"
                                                        Command="{Binding MoveSelectedCommand}"
                                                        Style="{StaticResource AccentButtonStyle}"
                                                        IsEnabled="{Binding CanPerformActions}"
                                                        Height="28"
                                                        Padding="10,0"
                                                        FontSize="12"
                                                        ToolTip="Переместить все отмеченные файлы во всех группах в указанную папку" />
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Files ListBox -->
                        <ListBox Grid.Row="1"
                                 x:Name="FilesListBox"
                                 AutomationProperties.AutomationId="FilesListBox"
                                 ItemsSource="{Binding SelectedGroup.Files}"
                                 ItemContainerStyle="{StaticResource FileListBoxItemStyle}"
                                 ScrollViewer.CanContentScroll="True"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling"
                                 VirtualizingPanel.ScrollUnit="Item"
                                 Padding="16,12">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:DuplicateFileItem}">
                                    <Grid Loaded="OnFileItemLoaded" DataContextChanged="OnFileItemDataContextChanged">
                                        <Grid.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Показать в Проводнике"
                                                          Command="{Binding DataContext.OpenInExplorerCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                          CommandParameter="{Binding}" />
                                                <MenuItem Header="Открыть файл"
                                                          Command="{Binding DataContext.OpenFileCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                          CommandParameter="{Binding}" />
                                                <MenuItem Header="Копировать полный путь"
                                                          Command="{Binding DataContext.CopyFilePathCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                          CommandParameter="{Binding}" />
                                                <Separator />
                                                <MenuItem Header="Удалить отмеченные во всех группах..."
                                                          Command="{Binding DataContext.DeleteSelectedCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                <MenuItem Header="Переместить отмеченные во всех группах..."
                                                          Command="{Binding DataContext.MoveSelectedCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                            </ContextMenu>
                                        </Grid.ContextMenu>

                                        <Grid.ColumnDefinitions>
                                            <!-- Checkbox -->
                                            <ColumnDefinition Width="Auto" />
                                            <!-- Thumbnail / Icon -->
                                            <ColumnDefinition Width="Auto" />
                                            <!-- File Information -->
                                            <ColumnDefinition Width="*" />
                                            <!-- Action Buttons -->
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- CheckBox -->
                                        <CheckBox Grid.Column="0"
                                                  IsChecked="{Binding IsChecked}"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,12,0" />

                                        <!-- Image Thumbnail or File Icon -->
                                        <Border Grid.Column="1"
                                                Width="60" Height="60"
                                                CornerRadius="6"
                                                Background="#18181B"
                                                BorderBrush="{StaticResource SubtleBorderBrush}"
                                                BorderThickness="1"
                                                Margin="0,0,14,0"
                                                ClipToBounds="True">
                                            <Grid>
                                                <!-- If it is an image -->
                                                <Grid Visibility="{Binding IsImage, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <Image Source="{Binding Thumbnail}"
                                                           Stretch="UniformToFill"
                                                           RenderOptions.BitmapScalingMode="HighQuality" />

                                                    <!-- Fallback if thumbnail not loaded -->
                                                    <TextBlock Text="🖼"
                                                               FontSize="22"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               Visibility="{Binding Thumbnail, Converter={StaticResource InverseNullToVisibilityConverter}}" />
                                                </Grid>

                                                <!-- If not an image -->
                                                <Grid Visibility="{Binding IsImage, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                                    <TextBlock Text="📄"
                                                               FontSize="26"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" />
                                                </Grid>
                                            </Grid>
                                        </Border>

                                        <!-- File Details -->
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <!-- File Name -->
                                            <TextBlock Text="{Binding FileName}"
                                                       FontWeight="SemiBold"
                                                       FontSize="13"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       Margin="0,0,0,3"
                                                       TextTrimming="CharacterEllipsis" />

                                            <!-- Full Directory Path -->
                                            <TextBlock Text="{Binding FilePath}"
                                                       FontSize="11"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding FilePath}"
                                                       Margin="0,0,0,5" />

                                            <!-- Metadata Row -->
                                            <StackPanel Orientation="Horizontal">
                                                <Border Background="#2E2E36" CornerRadius="3" Padding="6,2" Margin="0,0,8,0">
                                                    <TextBlock Text="{Binding SizeFormatted}" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}" />
                                                </Border>
                                                <TextBlock Text="Изменён: " FontSize="11" Foreground="{StaticResource TextDisabledBrush}" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding LastModifiedFormatted}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Right Button (Explorer) -->
                                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                                            <Button Content="В папке ↗"
                                                    Command="{Binding DataContext.OpenInExplorerCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="Показать файл в Проводнике Windows (также доступно по двойному щелчку)"
                                                    Height="28"
                                                    Padding="10,0"
                                                    FontSize="12" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Grid>
            </Grid>

            <!-- ERRORS PANEL (Collapsible) -->
            <Border Grid.Row="3"
                    Background="#2B1D1D"
                    BorderBrush="#5A2E2E"
                    BorderThickness="0,1,0,0"
                    MaxHeight="180"
                    Visibility="{Binding ShowErrorsPanel, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#3D1E1E" Padding="12,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="⚠️ Не удалось прочитать следующие файлы или каталоги:" FontWeight="SemiBold" FontSize="12" Foreground="#FCA5A5" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="✕ Закрыть" Command="{Binding ToggleErrorsPanelCommand}" Height="24" Padding="8,0" FontSize="11" />
                        </Grid>
                    </Border>

                    <ListBox Grid.Row="1"
                             AutomationProperties.AutomationId="ErrorsListBox"
                             ItemsSource="{Binding Errors}"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="8"
                             ScrollViewer.CanContentScroll="True"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             VirtualizingPanel.ScrollUnit="Item">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:ScanError}">
                                <Border BorderBrush="#4A2525" BorderThickness="0,0,0,1" Padding="4,4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding FormattedTime}" FontSize="11" Foreground="{StaticResource TextDisabledBrush}" Margin="0,0,10,0" />
                                        <TextBlock Grid.Column="1" Text="{Binding FilePath}" FontSize="11" Foreground="#FCA5A5" TextTrimming="CharacterEllipsis" Margin="0,0,10,0" />
                                        <TextBlock Grid.Column="2" Text="{Binding Message}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- STATUS BAR -->
            <Border Grid.Row="4"
                    Background="{StaticResource HeaderBgBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="16,6"
                    MinHeight="32">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Left statistics -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Просканировано: " Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                        <TextBlock Text="{Binding TotalFilesScanned, StringFormat='{}{0:N0} файлов'}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" Margin="0,0,16,0" />

                        <TextBlock Text="•  Групп дубликатов: " Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                        <TextBlock Text="{Binding TotalGroupsCount}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" Margin="0,0,16,0" />

                        <TextBlock Text="•  Потрачено места: " Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                        <TextBlock Text="{Binding TotalWastedSpaceFormatted}" FontWeight="Bold" Foreground="#F87171" FontSize="12" Margin="0,0,16,0" />

                        <TextBlock Text="•  Время: " Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                        <TextBlock Text="{Binding ElapsedTimeFormatted}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" />
                    </StackPanel>

                    <!-- Right errors button -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Command="{Binding ToggleErrorsPanelCommand}"
                                Visibility="{Binding Errors.Count, Converter={StaticResource IntGreaterThanZeroToVisibilityConverter}}"
                                Height="24"
                                Padding="8,0"
                                FontSize="11"
                                Cursor="Hand">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚠️ Ошибок: " Foreground="#FCA5A5" />
                                <TextBlock Text="{Binding Errors.Count}" FontWeight="Bold" Foreground="#FCA5A5" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</Window>
